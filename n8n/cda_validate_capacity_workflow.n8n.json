              "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ n: $json.n, ttl_dias: $json.ttl_dias }) }}",
        "options": {}
      },
      "id": "7c96e5ea-3f52-4ab8-b5e7-c8531656eefb",
      "name": "CURPs pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        464
      ]
    },
    {
      "parameters": {
        "batchSize": 400,
        "options": {}
      },
      "id": "aeb81281-08ea-4c50-9470-6c662df3e7d9",
      "name": "Lote de CURPs",
