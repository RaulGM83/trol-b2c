        }
      },
      "id": "fc78b6d9-30c8-4c4d-99ac-7cdd5d31e637",
      "name": "Token CDA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "executeOnce": true,
      "position": [
        880,
        592
      ]
    },
    {
      "parameters": {
        "jsCode": "// Re-emite las CURPs del lote actual (el nodo Token colapsa el flujo a 1 item).\nreturn $('Lote de CURPs').all();"
      },
      "id": "73a66fd6-cce6-4488-b280-b8f727c5fa42",
      "name": "Preparar lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        592
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api-core-production.millasparaelretiro.com/inquire/v1/contribution/validateCapacity",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization-pc",
              "value": "=Bearer-PC {{ $('Token CDA').first().json.model.token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ curp: $json.curp }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          },
          "timeout": 35000
        }
      },
      "id": "36ccdc92-712b-4b11-abb6-f5a8df1ac64c",
      "name": "Validar capacidad",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        592
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Une la respuesta del API con la CURP original (mismo orden del lote)\n// y arma las filas para cda_validaciones.\nconst originales = $('Preparar lote').all();\nconst respuestas = $input.all();\nconst rows = respuestas.map((it, i) => {\n  const o = originales[i] ? originales[i].json : {};\n  const j = it.json || {};\n  const ok = j.status === 200 && j.model && typeof j.model.canReceiveContributions === 'boolean';\n  return {\n    cliente_id: o.cliente_id || null,\n    curp: o.curp,\n    can_receive: ok ? j.model.canReceiveContributions : null,\n    status: (j.status !== undefined && j.status !== null) ? j.status : null,\n    message: j.message || (j.error ? String(j.error.message || j.error) : null),\n    fuente: 'batch'\n  };\n});\nconst resumen = {\n  lote: rows.length,\n  si_puede: rows.filter(r => r.can_receive === true).length,\n  no_puede: rows.filter(r => r.can_receive === false).length,\n  errores: rows.filter(r => r.can_receive === null).length\n};\nreturn [{ json: { rows, resumen } }];"
      },
      "id": "9cabc085-104a-45e5-b461-ef99f9571502",
      "name": "Construir filas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        592
      ]
    },
    {
