{
  "name": "Trol3 — nudges ventana 24h",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "cron",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "supabase_url",
              "value": "https://orgagfdxygtjiwqvgckw.supabase.co",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "service_role_key",
              "value": "REEMPLAZA_SERVICE_ROLE_KEY",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "tako_phone_number_id",
              "value": "933742489812669",
              "type": "string"
            },
            {
              "id": "c4",
              "name": "tako_template_nudge",
              "value": "reactivacion_calculadora3",
              "type": "string"
            },
            {
              "id": "c5",
              "name": "min_horas",
              "value": 3,
              "type": "number"
            },
            {
              "id": "c6",
              "name": "max_horas",
              "value": 22,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "cfg",
