      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.supabase_url }}/rest/v1/rpc/pendientes_nudge",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.service_role_key }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.service_role_key }}"
            },
            {
              "name": "Content-Profile",
              "value": "trol3"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ p_min_horas: $json.min_horas, p_max_horas: $json.max_horas }) }}",
        "options": {}
      },
      "id": "rpc",
      "name": "Supabase RPC: pendientes_nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "split",
      "name": "Uno por persona",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "t1",
              "leftValue": "={{ $json.telefono }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if",
      "name": "¿Con teléfono?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.insuranceboosters.com/api/v1/whatsapp/{{ $('Config (edita aquí)').item.json.tako_phone_number_id }}/template",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ to: '521' + String($json.telefono).replace(/\\D/g,'').slice(-10), name: $('Config (edita aquí)').item.json.tako_template_nudge, language: 'es', components: [ { type: 'body', parameters: [ { type: 'text', parameter_name: 'nombre', text: (($json.nombre || 'Hola').split(' ')[0]) } ] }, { type: 'button', sub_type: 'url', index: '0', parameters: [ { type: 'text', text: $json.persona_id + '?c=nudge' } ] } ] }) }}",
        "options": {}
      },
      "id": "tako",
      "name": "Tako: plantilla nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ZpH9oZH41ozAipds",
          "name": "Tako_API_Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (edita aquí)').item.json.supabase_url }}/rest/v1/rpc/registrar_salida",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config (edita aquí)').item.json.service_role_key }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config (edita aquí)').item.json.service_role_key }}"
            },
            {
              "name": "Content-Profile",
              "value": "trol3"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ p_persona: $('Uno por persona').item.json.persona_id, p_contenido: 'Nudge dentro de ventana 24h (sin respuesta desde hace ' + $('Uno por persona').item.json.horas + ' h): plantilla ' + $('Config (edita aquí)').item.json.tako_template_nudge + ' con link al expediente', p_meta: { nudge: '1', plantilla: $('Config (edita aquí)').item.json.tako_template_nudge } }) }}",
        "options": {}
      },
      "id": "reg",
      "name": "Registrar salida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        300
      ],
