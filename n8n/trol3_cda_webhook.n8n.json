      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook trol3-cda').first().json.body || {};\nconst j = $json || {};\nconst ok = j.status === 200 && j.model && typeof j.model.canReceiveContributions === 'boolean';\nconst puede = ok ? j.model.canReceiveContributions : null;\nreturn [{ json: {\n  row: {\n    cliente_id: b.cliente_id || null,\n    curp: b.curp,\n    can_receive: puede,\n    status: (j.status !== undefined && j.status !== null) ? j.status : null,\n    message: j.message || (j.error ? String(j.error.message || j.error) : null),\n    fuente: 'webhook'\n  },\n  consulta_id: b.trol3_consulta_id || null,\n  estado: ok ? 'completada' : 'error',\n  datos: puede === null ? {} : { puede_recibir_ahorro: puede, cuenta_registrada: true },\n  error_txt: ok ? null : ('CDA Millas: ' + (j.message || (j.status ? ('status ' + j.status) : 'sin respuesta')))\n} }];"
      },
      "id": "construir-cda",
      "name": "Construir resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
